<?xml version="1.0" ?>
<robot name="simple_quadrotor">

  <link name="base_link">
    
    <inertial>
      <mass value="0.5"/> <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0023" ixy="0" ixz="0" iyy="0.0023" iyz="0" izz="0.004"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.1 0.05"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.1 0.05"/>
      </geometry>
    </collision>
  </link>

  <link name="rotor_1">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.005"/>
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1"/> </material>
    </visual>
  </link>

  <joint name="joint_rotor_1" type="fixed">
    <parent link="base_link"/>
    <child link="rotor_1"/>
    <origin xyz="0.07 -0.07 0.03" rpy="0 0 0"/> 
  </joint>

  <link name="rotor_2">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.005"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
  </link>

  <joint name="joint_rotor_2" type="fixed">
    <parent link="base_link"/>
    <child link="rotor_2"/>
    <origin xyz="-0.07 0.07 0.03" rpy="0 0 0"/>
  </joint>

  <link name="rotor_3">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.005"/>
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>
  </link>

  <joint name="joint_rotor_3" type="fixed">
    <parent link="base_link"/>
    <child link="rotor_3"/>
    <origin xyz="0.07 0.07 0.03" rpy="0 0 0"/>
  </joint>

  <link name="rotor_4">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.005"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
  </link>

  <joint name="joint_rotor_4" type="fixed">
    <parent link="base_link"/>
    <child link="rotor_4"/>
    <origin xyz="-0.07 -0.07 0.03" rpy="0 0 0"/>
  </joint>

</robot>